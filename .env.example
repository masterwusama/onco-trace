# 复制为 .env 后填自己的值。.env 不提交。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_ot
DB_USER=root
DB_PASSWORD=

# 可选。取数时直连失败后尝试的代理；留空则只直连。
PROXY_URL=http://127.0.0.1:1080

# IHME 账号（GBD Results 与 CRA 两维）。留空表示这两支探针仍按匿名跑，结论是 blocked。
# 没有独立注册页：打开 https://vizhub.healthdata.org/gbd-results/ 会弹注册对话框，
# 或走顶栏 Account → Register，两者是同一条 B2C 流。表单只能人工在浏览器里填，
# 实测细节见 docs/MVP裁定.md。
IHME_USER=
IHME_PASS=
